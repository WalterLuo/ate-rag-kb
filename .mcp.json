{
  "mcpServers": {
    "ate-kb": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "-m",
        "ate_rag_kb.cli.main",
        "mcp"
      ],
      "env": {
        "CONFIG_PATH": "${CLAUDE_PLUGIN_ROOT}/configs/config.yaml",
        "ATE_KB_QUERY_DEVICE": "cpu",
        "ATE_KB_RERANKER_DEVICE": "cpu"
      }
    }
  }
}
